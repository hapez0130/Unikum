# Корзина - это просто список, куда добавляем блюда
cart = []

# Функция показывает главное меню
def show_menu():
    print("\n" + "=" * 50)
    print(" РЕСТОРАН 'В ПОДВАЛЕ'")
    print("=" * 50)
    # Проходим по всем категориям меню
    for key in menu:
        print(f"  [{key}]  {menu[key]['name']}")
    print("-" * 50)
    print("  [К]  Посмотреть корзину")
    print("  [В]  Выход")
    print("=" * 50)

# Функция показывает блюда в категории
def show_category(key):
    category = menu[key]
    print("\n" + "=" * 50)
    print(f"  {category['name']}")
    print("=" * 50)
    # Нумеруем блюда начиная с 1
    for i in range(len(category["items"])):
        item = category["items"][i]
        print(f"  [{i + 1}]  {item['name']} — {item['price']} ₽")
        if item["desc"] != "":
            print(f"        ↳ {item['desc']}")
    print("-" * 50)
    print("  [Н]  ← Назад в главное меню")
    print("=" * 50)

# Функция показывает корзину
def show_cart():
    if len(cart) == 0:
        print("\nКорзина пуста.\n")
        return
    
    print("\n" + "=" * 50)
    print(" ВАША КОРЗИНА")
    print("=" * 50)
    total = 0  # общая сумма
    for i in range(len(cart)):
        item = cart[i]
        print(f"  • {item['name']}  x{item['qty']}  —  {item['price'] * item['qty']} ₽")
        total = total + item['price'] * item['qty']
    print("-" * 50)
    print(f"  Итого: {total} ₽")
    print("=" * 50 + "\n")

# Функция считает сумму в корзине
def get_total():
    total = 0
    for i in range(len(cart)):
        total = total + cart[i]['price'] * cart[i]['qty']
    return total

# Функция оплаты
def pay():
    total = get_total()
    print("\n" + "=" * 50)
    print("ОПЛАТА ЗАКАЗА")
    print("=" * 50)
    print(f"  Сумма к оплате: {total} ₽")
    print("-" * 50)
    print("  Выберите способ оплаты:")
    print("  [1] Наличные")
    print("  [2] Банковская карта")
    print("  [3] СБП (QR-код)")
    print("=" * 50)

    choice = input("\nВаш выбор: ").strip()
    
    if choice == "1":
        cash = float(input(f"Внесите сумму (не менее {total} ₽): "))
        if cash >= total:
            print(f"\nОплата принята наличными!")
            if cash - total > 0:
                print(f"Ваша сдача: {cash - total} ₽")
        else:
            print("Недостаточно средств.")
    elif choice == "2":
        print("\nПриложите карту к терминалу...")
        time.sleep(1.5)
        print("Обработка платежа...")
        time.sleep(2)
        print("Оплата картой прошла успешно!")
    elif choice == "3":
        print("\nQR-код для оплаты через СБП:")
        print("   ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓")
        print("   ▓  [QR: PAY-" + str(total) + "]  ▓")
        print("   ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓")
        print("Ожидание подтверждения...")
        time.sleep(3)
        print("Платёж получен через СБП!")
    else:
        print("Неверный выбор.")

    # Печатаем чек
    print("\n" + "=" * 50)
    print("ЧЕК")
    print("=" * 50)
    print("  Ресторан 'В подвале'")
    print(f"  {datetime.now().strftime('%d.%m.%Y %H:%M')}")
    print("-" * 50)
    for i in range(len(cart)):
        item = cart[i]
        print(f"  {item['name']} x{item['qty']}  —  {item['price'] * item['qty']} ₽")
    print("-" * 50)
    print(f"  ИТОГО: {total} ₽")
    print("=" * 50)
    print("\nСпасибо за заказ! Приятного аппетита и без жертв!\n")

# Главная функция - запускает программу
def main():
    print("\nДобро пожаловать в ресторан 'В подвале'!")

    while True:
        show_menu()
        choice = input("\nВыберите категорию: ").strip().upper()

        # Выход из программы
        if choice == "В":
            if len(cart) > 0:
                confirm = input("\nВ корзине есть товары. Оформить заказ? (д/н): ").strip().lower()
                if confirm == "д":
                    show_cart()
                    pay()
                    break  # останавливаем программу
            print("\nДо свидания!\n")
            break

        # Показать корзину
        elif choice == "К":
            show_cart()
            if len(cart) > 0:
                action = input("[О] Оформить  [У] Удалить всё  [ENTER] Назад: ").strip().upper()
                if action == "О":
                    pay()
                    break  # останавливаем программу
                elif action == "У":
                    cart.clear()  # очищаем список
                    print("\nКорзина очищена.")

        # Выбрать категорию
        elif choice in menu:
            while True:
                show_category(choice)
                item_choice = input("\nВыберите блюдо (номер) или [Н] назад: ").strip()

                if item_choice.upper() == "Н":
                    break

                try:
                    idx = int(item_choice) - 1
                    if 0 <= idx < len(menu[choice]["items"]):
                        item = menu[choice]["items"][idx]
                        qty_str = input(f"Сколько порций '{item['name']}' добавить? [1]: ").strip()
                        qty = int(qty_str) if qty_str != "" else 1
                        
                        # Добавляем в корзину
                        cart.append({"name": item["name"], "price": item["price"], "qty": qty})
                        print(f"\nДобавлено: {item['name']} x{qty}")
                    else:
                        print("Нет такого блюда.")
                except:
                    print("Введите номер блюда.")


# Запуск программы
main()
