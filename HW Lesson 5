#5. Кто будет покупать? Целевая аудитория (ЦА)?
# Муниципалитеты и коммунальные службы (закупки через гостендеры).
# Владельцы частных пляжей, курортных отелей и баз отдыха (решение принимает владелец или управляющий, ориентированный на премиальный сервис).
# Экологические НКО и волонтерские организации (часто выступают инициаторами пилотных проектов через гранты).
# Корпорации в рамках программ КСО (корпоративная социальная ответственность), спонсирующие очистку побережий.

import cv2
import numpy as np
import time

class BeachCleaningDroneVision:
    def __init__(self):
        # self.model = YOLO('beach_trash_model.pt')
        print("Система зрения пляжного дрона инициализирована.")
        
        self.lower_shard = np.array([0, 0, 200])
        self.upper_shard = np.array([180, 50, 255])

    def process_frame(self, frame):
        height, width = frame.shape[:2]
        detected_objects = []

        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        mask = cv2.inRange(hsv, self.lower_shard, self.upper_shard)
        
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        for cnt in contours:
            area = cv2.contourArea(cnt)
            if area > 100:
                x, y, w, h = cv2.boundingRect(cnt)
                
                obj_type = "Осколок стекла" if area < 500 else "Крупный мусор"
                confidence = np.random.uniform(0.85, 0.99)
                
                detected_objects.append({
                    "type": obj_type,
                    "bbox": (x, y, w, h),
                    "confidence": confidence,
                    "center": (x + w//2, y + h//2)
                })
                
                color = (0, 0, 255) if obj_type == "Осколок стекла" else (0, 255, 0)
                cv2.rectangle(frame, (x, y), (x+w, y+h), color, 2)
                cv2.putText(frame, f"{obj_type} ({confidence:.2f})", (x, y-10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

        return frame, detected_objects

    def send_to_mechanism(self, detected_objects):
        if not detected_objects:
            return "Мусор не обнаружен, продолжаем патрулирование."
        
        priority_objects = sorted(detected_objects, key=lambda x: 0 if x["type"] == "Осколок стекла" else 1)
        target = priority_objects[0]
        
        msg = f"Цель захвачена: {target['type']}. Координаты в кадре: X={target['center'][0]}, Y={target['center'][1]}. Отправка манипулятору..."
        return msg

if __name__ == "__main__":
    drone_vision = BeachCleaningDroneVision()

    print("Запуск симуляции видеопотока с камеры дрона...\n")
    
    for i in range(3):
        # Генерируем случайный "кадр" (бежевый фон, как песок)
        frame = np.full((480, 640, 3), (210, 180, 140), dtype=np.uint8)
        
        cv2.rectangle(frame, (100, 100), (150, 150), (255, 255, 255), -1) # Яркий объект (осколок)
        cv2.circle(frame, (400, 300), 30, (100, 100, 100), -1) # Темный объект (мусор)

        processed_frame, objects = drone_vision.process_frame(frame)
        action_message = drone_vision.send_to_mechanism(objects)
        
        print(f"Кадр #{i+1}: {action_message}")
        
        # Показ кадра (раскомментируйте для локального запуска с GUI)
