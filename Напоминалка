# Импортируем библиотеки для работы со временем
import time
from datetime import datetime


# ============================================================================
# КЛАСС MenuItem - пункт меню
# ============================================================================
# Класс - это шаблон для создания объектов. Каждый объект MenuItem хранит
# информацию об одном блюде: название, цену и описание.
class MenuItem:
    # Метод __init__ вызывается автоматически при создании объекта
    # self - ссылка на сам объект (обязательный параметр)
    def __init__(self, name, price, description=""):
        self.name = name              # Название блюда
        self.price = price            # Цена в рублях
        self.description = description # Описание (по умолчанию пустое)

    # Метод __str__ определяет, как объект выглядит при печати
    # Когда мы пишем print(item), вызывается этот метод
    def __str__(self):
        return f"{self.name} — {self.price} ₽"


# ============================================================================
# КЛАСС Cart - корзина пользователя
# ============================================================================
# Этот класс управляет всеми товарами, которые пользователь добавил к заказу.
# Хранит список пар (блюдо, количество).
class Cart:
    def __init__(self):
        # items - список кортежей вида (MenuItem, количество)
        # Пример: [(item1, 2), (item2, 1)] означает 2 порции item1 и 1 порцию item2
        self.items = []

    # Метод добавления товара в корзину
    def add(self, item, quantity=1):
        # Проходим по всем товарам в корзине с помощью enumerate
        # enumerate возвращает пары (индекс, значение)
        for i, (existing_item, qty) in enumerate(self.items):
            # Если такое блюдо уже есть в корзине
            if existing_item.name == item.name:
                # Увеличиваем количество и выходим из функции
                self.items[i] = (existing_item, qty + quantity)
                return  # return без значения просто выходит из функции
        
        # Если блюда нет в корзине, добавляем его как новую пару
        self.items.append((item, quantity))

    # Метод удаления товара по названию
    def remove(self, item_name):
        # Создаём новый список, оставляя только те товары, у которых другое название
        # Это называется "генератор списка" (list comprehension)
        self.items = [(i, q) for i, q in self.items if i.name != item_name]

    # Метод подсчёта общей суммы заказа
    def total(self):
        # sum() складывает все значения из генератора
        # Для каждого товара умножаем цену на количество
        return sum(item.price * qty for item, qty in self.items)

    # Метод подсчёта общего количества позиций
    def count(self):
        # Складываем все количества
        return sum(qty for _, qty in self.items)
        # _ означает, что мы игнорируем первое значение (сам товар)

    # Метод отображения содержимого корзины
    def display(self):
        if not self.items:
            # Если список пустой
            print("\nКорзина пуста. Вы как тот самый программист: работает, но ничего не делает.\n")
            return
        
        print("\n" + "=" * 50)
        print(" ВАША КОРЗИНА (Путь к финансовому краху)")
        print("=" * 50)
        
        # Проходим по всем товарам в корзине
        for item, qty in self.items:
            subtotal = item.price * qty  # Сумма за этот товар
            print(f"  • {item.name}  x{qty}  —  {subtotal} ₽")
        
        print("-" * 50)
        print(f"  Итого к оплате: {self.total()} ₽")
        print("=" * 50 + "\n")


