# ============================================================================
# ФУНКЦИЯ show_category - отображение категории с блюдами
# ============================================================================
def show_category(category_key):
    # Получаем категорию из словаря по ключу
    category = MENU[category_key]
    
    print("\n" + "=" * 50)
    print(f"  {category['name']}")
    print("=" * 50)
    
    # enumerate(..., 1) нумерует элементы начиная с 1
    for i, item in enumerate(category["items"], 1):
        print(f"  [{i}]  {item}")  # Здесь вызывается метод __str__ у MenuItem
        if item.description:
            print(f"        ↳ {item.description}")
    
    print("-" * 50)
    print("  [Н]  ← Назад в главное меню")
    print("=" * 50)


# ============================================================================
# ФУНКЦИЯ process_payment - обработка оплаты заказа
# ============================================================================
def process_payment(cart):
    total = cart.total()  # Получаем общую сумму из корзины
    
    print("\n" + "=" * 50)
    print("ОПЛАТА ЗАКАЗА")
    print("=" * 50)
    print(f"  Сумма к оплате: {total} ₽")
    print("-" * 50)
    print("  Выберите способ оплаты:")
    print("  [1] Наличные (мелочью не брать)")
    print("  [2] Банковская карта (лимит не проверяем)")
    print("  [3] СБП (QR-код)")
    print("=" * 50)

    # Бесконечный цикл, пока пользователь не выберет корректный способ оплаты
    while True:
        choice = input("\nВаш выбор: ").strip()  # strip() убирает пробелы по краям
        
        if choice == "1":
            # Обработка оплаты наличными
            while True:
                try:
                    # Пытаемся преобразовать ввод в число
                    cash = float(input(f"Внесите сумму (не менее {total} ₽): "))
                    
                    if cash >= total:
                        change = cash - total  # Считаем сдачу
                        print(f"\nОплата принята наличными!")
                        if change > 0:
                            print(f"Ваша сдача: {change:.2f} ₽ (мы её, возможно, потеряем)")
                        break  # Выходим из внутреннего цикла
                    else:
                        print(f"Недостаточно средств. Нужно ещё {total - cash:.2f} ₽")
                
                except ValueError:
                    # Если пользователь ввёл не число, float() вызовет ошибку ValueError
                    print("Введите число, а не название криптовалюты.")
            break  # Выходим из внешнего цикла
            
        elif choice == "2":
            # Имитация оплаты картой с паузами
            print("\nПриложите карту к терминалу...")
            time.sleep(1.5)  # Пауза 1.5 секунды
            print("Обработка платежа... (молимся, чтобы прошло)")
            time.sleep(2)
            print("Оплата картой прошла успешно!")
            break
            
        elif choice == "3":
            # Имитация оплаты через СБП
            print("\nСгенерирован QR-код для оплаты через СБП")
            print("   ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓")
            print("   ▓  [QR: PAY-" + str(total) + "]  ▓")
            print("   ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓")
            print("Ожидание подтверждения...")
            time.sleep(3)
            print("Платёж получен через СБП!")
            break
            
        else:
            print("Неверный выбор, попробуйте снова.")

    # Печатаем чек
    print("\n" + "=" * 50)
    print("ЧЕК")
    print("=" * 50)
    print(f"  Ресторан 'В подвале'")
    # datetime.now() - текущая дата и время
    # strftime() - форматирование в строку
    print(f"  {datetime.now().strftime('%d.%m.%Y %H:%M')}")
    print("-" * 50)
    
    for item, qty in cart.items:
        print(f"  {item.name} x{qty}  —  {item.price * qty} ₽")
    
    print("-" * 50)
    print(f"  ИТОГО: {total} ₽")
    print("=" * 50)
    print("\nСпасибо за заказ! Приятного аппетита и крепких нервов!\n")


# ============================================================================
# ФУНКЦИЯ main - главный цикл программы
# ============================================================================
def main():
    # Создаём пустую корзину
    cart = Cart()
    
    print("\nДобро пожаловать в ресторан 'В подвале'!")
    print("Здесь еда странная, но цены честные (почти).")

    # Бесконечный цикл работы программы
    while True:
        show_main_menu()
        # input() - считываем ввод пользователя
        # strip() - убираем пробелы, upper() - переводим в верхний регистр
        choice = input("\nВыберите категорию: ").strip().upper()

        if choice == "В":
            # Выход из программы
            if cart.count() > 0:
                # Если корзина не пуста, спрашиваем про оформление
                confirm = input("\nВ корзине есть товары. Оформить заказ перед выходом? (д/н): ").strip().lower()
                if confirm == "д":
                    cart.display()
                    process_payment(cart)
            print("\nДо свидания! Заходите ещё (но лучше не надо).\n")
            break  # Выход из бесконечного цикла

        elif choice == "К":
            # Просмотр корзины
            cart.display()
            if cart.count() > 0:
                action = input("[О] Оформить заказ  [У] Удалить всё  [ENTER] Назад: ").strip().upper()
                if action == "О":
                    process_payment(cart)
                    cart = Cart()  # Создаём новую пустую корзину
                elif action == "У":
                    cart = Cart()  # Очищаем корзину
                    print("\nКорзина очищена. Вы сэкономили кучу денег!")

        elif choice in MENU:
            # Если выбрана категория (1-5)
            while True:
                show_category(choice)
                item_choice = input("\nВыберите блюдо (номер) или [Н] назад: ").strip().upper()

                if item_choice == "Н":
                    break  # Возврат в главное меню

                try:
                    # Пытаемся преобразовать ввод в номер блюда
                    idx = int(item_choice) - 1  # -1, потому что нумерация с 1, а индексы с 0
                    
                    if 0 <= idx < len(MENU[choice]["items"]):
                        # Если номер корректный
                        item = MENU[choice]["items"][idx]  # Получаем блюдо по индексу
                        qty_str = input(f"Сколько порций '{item.name}' добавить? [1]: ").strip()
                        
                        # Если пользователь ничего не ввёл, используем 1
                        qty = int(qty_str) if qty_str else 1
                        
                        if qty <= 0:
                            print("Количество должно быть больше нуля. Мы не в минусе работаем.")
                            continue  # Переходим к следующей итерации цикла
                        
                        cart.add(item, qty)  # Добавляем в корзину
                        print(f"\nДобавлено: {item.name} x{qty}")
                    else:
                        print("Нет такого блюда. Вы что, из будущего?")
                
                except ValueError:
                    # Если пользователь ввёл не число
                    print("Введите номер блюда, а не секретный код.")


